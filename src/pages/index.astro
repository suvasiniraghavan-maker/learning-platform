---
import Base from "../layouts/Base.astro";
import {
  kb,
  tracks,
  modules,
  totalItems,
  totalQuizItems,
  totalLabs,
  sectionPath,
  quizPath,
  sectionLabel,
  levelRange,
} from "../lib/kb";
import type { Section } from "../lib/kb";
import plan from "../../content/curriculum-plan.json";

const quizCount = (section: Section) =>
  section.items.filter((item) => item.kind === "mcq").length;

const stageSummary = plan.stages.map((stage) => ({
  id: stage.id,
  title: stage.title,
  live: stage.sections.filter((entry) => entry.status === "live").length,
  planned: stage.sections.filter((entry) => entry.status === "planned").length,
}));

const tickerTopics = [
  "tokens",
  "context",
  "memory",
  "retrieval",
  "agents",
  "tools",
  "evals",
  "security",
  "economics",
  "infrastructure",
];
---

<Base>
  <section class="page-head">
    <p class="eyebrow">Knowledge base</p>
    <h1>{kb.title}</h1>
    <p class="lead">{kb.description}</p>
    <div class="meta-row" data-pagefind-ignore>
      <span>{tracks.length} tracks</span>
      <span>{modules.length} modules</span>
      <span>{totalItems} items</span>
      <span>{totalQuizItems} quiz questions</span>
      {totalLabs > 0 && <span>{totalLabs} hands-on labs</span>}
      <span>Progress saved in your browser</span>
    </div>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {[...tickerTopics, ...tickerTopics].map((topic) => (
        <span>{topic} ✦</span>
      ))}
    </div>
  </div>

  <section class="path-strip" style="margin-bottom:2rem">
    <h2>Learning path</h2>
    <p class="muted" style="margin-bottom:.75rem">
      Eight stages, ordered by dependency — from how models learn to vendor deep
      dives. <a href="/curriculum/">See the full curriculum map</a>.
    </p>
    <div class="row" style="flex-wrap:wrap;gap:.5rem" data-pagefind-ignore>
      {
        stageSummary.map((stage) => (
          <a class="badge" href={`/curriculum/#${stage.id}`}>
            {stage.title} · {stage.live} live
            {stage.planned > 0 ? ` · ${stage.planned} planned` : ""}
          </a>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Tracks</h2>
    <p class="muted" style="margin-bottom:1rem">
      The core curriculum, from token mechanics to enterprise data moats.
    </p>
    <div class="card-grid">
      {
        tracks.map((section) => {
          const quiz = quizCount(section);
          return (
            <article class="card">
              <p class="eyebrow" style="margin-bottom:.1rem">
                {sectionLabel(section)}
              </p>
              <h2>{section.title}</h2>
              <p>{section.description}</p>
              <div class="row" style="margin-top:.35rem" data-pagefind-ignore>
                <span class="badge">{quiz} quiz</span>
                <span class="badge">{levelRange(section.items)}</span>
                {section.priority && (
                  <span class="badge">{section.priority}</span>
                )}
              </div>
              <div class="card-actions" data-pagefind-ignore>
                <a class="btn btn-primary" href={sectionPath(section.id)}>
                  Study
                </a>
                <a class="btn" href={quizPath(section.id)}>
                  Quiz me
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <section style="margin-top:3rem">
    <h2>Modules</h2>
    <p class="muted" style="margin-bottom:1rem">
      Provider deep dives and the hands-on free tools lab.
    </p>
    <div class="card-grid">
      {
        modules.map((section) => {
          const quiz = quizCount(section);
          return (
            <article class="card">
              <p class="eyebrow" style="margin-bottom:.1rem">
                {sectionLabel(section)}
              </p>
              <h2>{section.title}</h2>
              <p>{section.description}</p>
              <div class="row" style="margin-top:.35rem" data-pagefind-ignore>
                <span class="badge">{quiz} quiz</span>
                <span class="badge">{levelRange(section.items)}</span>
                {section.priority && (
                  <span class="badge">{section.priority}</span>
                )}
              </div>
              <div class="card-actions" data-pagefind-ignore>
                <a class="btn btn-primary" href={sectionPath(section.id)}>
                  Study
                </a>
                {quiz > 0 ? (
                  <a class="btn" href={quizPath(section.id)}>
                    Quiz me
                  </a>
                ) : (
                  <a class="btn" href={sectionPath(section.id)}>
                    Open labs
                  </a>
                )}
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <section class="stack" style="margin-top:3rem;max-width:70ch">
    <h2>How it works</h2>
    <p class="muted">
      Every section is generated from <code>content/kb.json</code>. Study mode
      shows the question first so you can retrieve the answer before revealing
      it, then shows the principle, the PM implication, further reading, and a
      Gemini Notebook prompt. Quiz mode auto-grades multiple choice and
      schedules cards with a simple spaced-repetition algorithm.
    </p>
    <p class="muted">
      Each section can also be exported as a Markdown bundle for a Gemini
      Notebook. Run <code>npm run notebooks</code> to generate them.
    </p>
  </section>
</Base>
